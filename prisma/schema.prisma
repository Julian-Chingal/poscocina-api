// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── USUARIOS Y RBAC ─────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  name         String
  googleId     String?  @unique @map("google_id")
  isActive     Boolean  @default(true) @map("is_active")
  roleId       String   @map("role_id")
  
  role         Role     @relation(fields: [roleId], references: [id])
  orders       Order[]
  auditLogs    AuditLog[]
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique  // ADMIN, CASHIER, COOK, WAITER
  description String?
  permissions RolePermission[]
  users       User[]
  
  @@map("roles")
}

model Module {
  id          String       @id @default(uuid())
  name        String       @unique  // pos, inventory, products, reports, users
  permissions Permission[]
  
  @@map("modules")
}

model Permission {
  id       String           @id @default(uuid())
  module   Module           @relation(fields: [moduleId], references: [id])
  moduleId String           @map("module_id")
  action   String           // read, write, delete, manage
  roles    RolePermission[]
  
  @@unique([moduleId, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  
  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─── PRODUCTOS ────────────────────────────────────────────

model Category {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  parentId String?   @map("parent_id")
  parent   Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
  
  @@map("categories")
}

model Product {
  id           String           @id @default(uuid())
  name         String
  description  String?
  basePrice    Decimal          @map("base_price") @db.Decimal(10, 2)
  categoryId   String           @map("category_id")
  isCombo      Boolean          @default(false) @map("is_combo")
  isActive     Boolean          @default(true) @map("is_active")
  imageUrl     String?          @map("image_url")
  metadata     Json?            // atributos extra sin romper el schema
  
  category     Category         @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  modifiers    ProductModifier[]
  comboItems   ComboItem[]      @relation("ComboParent")
  asComboItem  ComboItem[]      @relation("ComboChild")
  recipeItems  RecipeItem[]
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("products")
}

model ProductVariant {
  id            String  @id @default(uuid())
  productId     String  @map("product_id")
  name          String  // "Grande", "Sin gluten", "Personal"
  priceOverride Decimal? @map("price_override") @db.Decimal(10, 2)
  sku           String?  @unique
  attributes    Json?   // { size: 'L', color: 'red' }
  isDefault     Boolean @default(false) @map("is_default")
  
  product       Product    @relation(fields: [productId], references: [id])
  orderItems    OrderItem[]
  
  @@map("product_variants")
}

model ProductModifier {
  id        String @id @default(uuid())
  productId String @map("product_id")
  name      String  // "Sin cebolla", "Extra queso"
  type      String  // ADD, REMOVE, SUBSTITUTE
  price     Decimal @default(0) @db.Decimal(10, 2)
  
  product   Product @relation(fields: [productId], references: [id])
  
  @@map("product_modifiers")
}

model ComboItem {
  id              String  @id @default(uuid())

  comboProductId  String @map("combo_product_id")
  childProductId  String  @map("child_product_id")
  quantity        Int     @default(1)
  isRequired      Boolean @default(true)
  comboProduct    Product @relation("ComboParent", fields: [comboProductId], references: [id])
  childProduct    Product @relation("ComboChild", fields: [childProductId], references: [id])

  @@unique([comboProductId, childProductId])

  @@map("combo_items")
}

// ─── INVENTARIO ───────────────────────────────────────────

model Ingredient {
  id           String         @id @default(uuid())
  name         String
  unit         String         // kg, g, L, ml, units
  costPerUnit  Decimal        @map("cost_per_unit") @db.Decimal(10, 4)
  minStock     Decimal        @map("min_stock") @db.Decimal(10, 3)
  
  stock        InventoryStock?
  movements    StockMovement[]
  recipeItems  RecipeItem[]
  
  @@map("ingredients")
}

model InventoryStock {
  id           String     @id @default(uuid())
  ingredientId String     @unique @map("ingredient_id")
  quantity     Decimal    @db.Decimal(10, 3)
  lastUpdated  DateTime   @updatedAt @map("last_updated")
  
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  
  @@map("inventory_stock")
}

model StockMovement {
  id           String     @id @default(uuid())
  ingredientId String     @map("ingredient_id")
  type         String     // IN, OUT, ADJUSTMENT, WASTE
  quantity     Decimal    @db.Decimal(10, 3)
  reason       String?
  reference    String?    // orderId si es OUT por venta
  userId       String     @map("user_id")
  
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")
  
  @@map("stock_movements")
}

model RecipeItem {
  id           String     @id @default(uuid())
  productId    String     @map("product_id")
  ingredientId String     @map("ingredient_id")
  quantity     Decimal    @db.Decimal(10, 4)  // cantidad por porción
  
  product      Product    @relation(fields: [productId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  
  @@unique([productId, ingredientId])
  @@map("recipe_items")
}

// ─── ÓRDENES Y POS ────────────────────────────────────────

enum OrderStatus {
  OPEN
  IN_KITCHEN
  READY
  DELIVERED
  PAID
  CANCELLED
}

model Table {
  id       String  @id @default(uuid())
  number   Int     @unique
  zone     String?
  capacity Int     @default(4)
  isActive Boolean @default(true) @map("is_active")
  orders   Order[]
  
  @@map("tables")
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique @map("order_number") // Ej: "ORD-2024-0001"
  status      OrderStatus @default(OPEN)
  tableId     String?     @map("table_id")
  cashierId   String      @map("cashier_id")
  subtotal    Decimal     @db.Decimal(10, 2)
  tax         Decimal     @db.Decimal(10, 2)
  discount    Decimal     @default(0) @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)
  notes       String?
  
  table       Table?        @relation(fields: [tableId], references: [id])
  cashier     User          @relation(fields: [cashierId], references: [id])
  items       OrderItem[]
  payment     Payment?
  tickets     KitchenTicket[]
  
  openedAt    DateTime @default(now()) @map("opened_at")
  closedAt    DateTime? @map("closed_at")
  
  @@index([status])
  @@index([openedAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String  @map("order_id")
  variantId   String  @map("variant_id")
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  notes       String?
  
  order       Order          @relation(fields: [orderId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  modifiers   OrderItemModifier[]
  
  @@map("order_items")
}

model OrderItemModifier {
  id          String @id @default(uuid())
  orderItemId String @map("order_item_id")
  name        String
  type        String // ADD, REMOVE
  price       Decimal @db.Decimal(10, 2)
  
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  
  @@map("order_item_modifiers")
}

// ─── COCINA ───────────────────────────────────────────────

model KitchenTicket {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  station     String   // GRILL, COLD, BAR, FRYER
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, DONE
  priority    Int      @default(0)
  
  order       Order    @relation(fields: [orderId], references: [id])
  sentAt      DateTime @default(now()) @map("sent_at")
  completedAt DateTime? @map("completed_at")
  
  @@index([status, station])
  @@map("kitchen_tickets")
}

// ─── PAGOS ────────────────────────────────────────────────

model Payment {
  id        String  @id @default(uuid())
  orderId   String  @unique @map("order_id")
  method    String  // CASH, CARD, TRANSFER, MIXED
  amount    Decimal @db.Decimal(10, 2)
  change    Decimal @default(0) @db.Decimal(10, 2)
  reference String?
  
  order     Order   @relation(fields: [orderId], references: [id])
  paidAt    DateTime @default(now()) @map("paid_at")
  
  @@map("payments")
}

// ─── AUDITORÍA ────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String   // CREATE_ORDER, UPDATE_STOCK, LOGIN, etc.
  entity     String   // Order, Product, Ingredient
  entityId   String   @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ip         String?
  
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")
  
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}