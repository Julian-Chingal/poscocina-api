// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── USUARIOS Y RBAC ─────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  name         String
  googleId     String?  @unique @map("google_id")
  isActive     Boolean  @default(true) @map("is_active")
  roleId       String   @map("role_id")
  
  role         Role     @relation(fields: [roleId], references: [id])
  orders       Order[]
  auditLogs    AuditLog[]
  securityLogs SecurityLog[]
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique  // ADMIN, CASHIER, COOK, WAITER
  label       String?          
  description String?
  permissions RolePermission[]
  users       User[]
  
  @@map("roles")
}

model Module {
  id          String       @id @default(uuid())
  name        String       @unique  // pos, inventory, products, reports, users
  label       String?
  permissions Permission[]
  
  @@map("modules")
}

enum PermissionAction {
  read
  write
  delete
  manage
}

model Permission {
  id       String           @id @default(uuid())
  module   Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId String           @map("module_id")
  action   PermissionAction           // read, write, delete, manage
  label    String?
  roles    RolePermission[]
  
  @@unique([moduleId, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  
  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─── PRODUCTOS ────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String
  parentId    String?   @map("parent_id")
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  
  @@map("categories")
}

model Product {
  id           String           @id @default(uuid())
  name         String
  description  String?
  basePrice    Decimal          @map("base_price") @db.Decimal(10, 2)
  imageUrl     String?          @map("image_url")
  sku          String?          @unique
  isActive     Boolean          @default(true) @map("is_active")
  categoryId   String           @map("category_id")

  isCombo      Boolean          @default(false) @map("is_combo")
  comboType    String?          @map("combo_type") // "FIXED" | "CONFIGURABLE"

  trackStock   Boolean          @default(true) @map("track_stock")

  metadata     Json?            // atributos extra sin romper el schema
  
  comboSlots     ComboSlot[]      @relation("ComboWithSlots")
  category       Category         @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  modifierGroups ModifierGroup[]
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model ProductVariant {
  id            String  @id @default(uuid())
  productId     String  @map("product_id")
  name          String  // "Grande", "Sin gluten", "Personal"
  sku           String?  @unique
  priceOverride Decimal? @map("price_override") @db.Decimal(10, 2) // Si null, usa basePrice del producto
  sortOrder     Int      @default(0) @map("sort_order")
  isDefault     Boolean @default(false) @map("is_default")
  attributes    Json?   // { size: 'L', color: 'red' }
  useRecipe     Boolean        @default(false) @map("use_recipe")
  
  product        Product    @relation(fields: [productId], references: [id])
  comboItemsAsParent ComboItem[]       @relation("ComboVariantParent")
  comboItemsAsChild  ComboItem[]       @relation("ComboVariantChild")
  comboSlotOptions   ComboSlotOption[]

  variantStocks  VariantStock[]
  recipeItems    RecipeItem[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ModifierGroup {
  id          String @id @default(uuid())
  productId   String @map("product_id")
  name        String  // "Extras", "Sin ingredientes
  description String?  
  isRequired  Boolean    @default(false) @map("is_required")
  minSelect   Int        @default(0) @map("min_select")
  maxSelect   Int        @default(1) @map("max_select")
  sortOrder   Int        @default(0) @map("sort_order")
  price       Decimal @default(0) @db.Decimal(10, 2)
  
  product   Product @relation(fields: [productId], references: [id])
  modifierOptions ModifierOption[]
  
  @@index([productId])
  @@map("modifier_groups")
}

model ModifierOption {
  id                 String        @id @default(uuid())
  modifierGroupId    String        @map("modifier_group_id")
  ingredientId       String?       @map("ingredient_id")
  name               String        // "Extra queso", "Sin cebolla"
  type               String        // "ADD" | "REMOVE" | "SUBSTITUTE"
  price              Decimal       @default(0) @db.Decimal(10, 2) // Precio adicional (puede ser negativo para descuentos)
  ingredientQuantity Decimal?   @map("ingredient_quantity") @db.Decimal(10, 4)
  isDefault          Boolean       @default(false) @map("is_default")
  isActive           Boolean       @default(true) @map("is_active")
  sortOrder          Int           @default(0) @map("sort_order")

  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  ingredient      Ingredient?   @relation(fields: [ingredientId], references: [id])
 
  @@index([modifierGroupId])
  @@map("modifier_options")
}

model ComboItem {
  id               String  @id @default(uuid())
  comboVariantId   String @map("combo_variant_id")
  childVariantId   String  @map("child_variant_id")
  quantity         Int     @default(1)
  priceOverride    Decimal? @map("price_override") @db.Decimal(10, 2)
  sortOrder        Int      @default(0) @map("sort_order")

  comboVariant     ProductVariant @relation("ComboVariantParent", fields: [comboVariantId], references: [id])
  childVariant     ProductVariant @relation("ComboVariantChild", fields: [childVariantId], references: [id])

  @@unique([comboVariantId, childVariantId])
  @@index([comboVariantId])
  @@map("combo_items")
}

model ComboSlot {
  id             String        @id @default(uuid())
  comboProductId String        @map("combo_product_id")
  name           String        // "Plato fuerte", "Bebida", "Postre"
  description    String?
  isRequired     Boolean       @default(true) @map("is_required")
  minSelect      Int           @default(1) @map("min_select")
  maxSelect      Int           @default(1) @map("max_select")
  sortOrder      Int           @default(0) @map("sort_order")

  comboProduct   Product       @relation("ComboWithSlots", fields: [comboProductId], references: [id], onDelete: Cascade)
  options        ComboSlotOption[]

  @@index([comboProductId])
  @@map("combo_slots")
}

model ComboSlotOption {
  id                String     @id @default(uuid())
  comboSlotId       String     @map("combo_slot_id")
  productVariantId  String     @map("product_variant_id")
  priceOverride     Decimal?   @map("price_override") @db.Decimal(10, 2)
  isDefault         Boolean    @default(false) @map("is_default")

  comboSlot      ComboSlot      @relation(fields: [comboSlotId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([comboSlotId, productVariantId])
  @@map("combo_slot_options")
}
// ─── INVENTARIO ───────────────────────────────────────────

model Location {
  id          String   @id @default(uuid())
  name        String   // "Cocina Principal", "Barra Barra Principal", "Bodega Central"
  description String?
  isActive    Boolean  @default(true) @map("is_active")

  inventoryStocks InventoryStock[]
  variantStocks   VariantStock[]
  stockMovements  StockMovement[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("locations")
}

model Ingredient {
  id           String         @id @default(uuid())
  name         String
  description  String?
  unit         String         // kg, g, L, ml, units
  costPerUnit  Decimal        @map("cost_per_unit") @db.Decimal(10, 4)
  minStock     Decimal        @map("min_stock") @db.Decimal(10, 3)
  isActive     Boolean         @default(true) @map("is_active")
  
  stocks        InventoryStock[]
  movements    StockMovement[]
  recipeItems  RecipeItem[]
  modifierOptions ModifierOption[]

  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  
  @@map("ingredients")
}

model InventoryStock {
  id           String     @id @default(uuid())
  ingredientId String     @map("ingredient_id")
  locationId   String     @map("location_id")
  quantity     Decimal    @db.Decimal(10, 3)
  lastUpdated  DateTime   @updatedAt @map("last_updated")
  
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  location     Location   @relation(fields: [locationId], references: [id])
  
  @@unique([ingredientId, locationId])
  @@map("inventory_stock")
}

model VariantStock {
  id                String   @id @default(uuid())
  productVariantId  String   @map("product_variant_id")
  locationId        String   @map("location_id")
  quantity          Decimal  @db.Decimal(10, 2)
  lastUpdated       DateTime @updatedAt @map("last_updated")

  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  location         Location       @relation(fields: [locationId], references: [id])
  
  @@unique([productVariantId, locationId])
  @@map("variant_stock")
}

model StockMovement {
  id                String     @id @default(uuid())
  ingredientId      String?    @map("ingredient_id")
  productVariantId  String?    @map("product_variant_id")
  locationId        String     @map("location_id")
  type              String     // IN, OUT, ADJUSTMENT, WASTE
  quantity          Decimal    @db.Decimal(10, 3)
  reason            String?
  reference         String?    // orderId si es OUT por venta
  cost              Decimal?   @db.Decimal(10, 4)
  userId            String     @map("user_id")
  
  ingredient     Ingredient?     @relation(fields: [ingredientId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])
  location       Location        @relation(fields: [locationId], references: [id])

  createdAt    DateTime   @default(now()) @map("created_at")
  
  @@index([ingredientId, createdAt])
  @@index([productVariantId, createdAt])
  @@index([locationId])
  @@index([reference])
  @@map("stock_movements")
}

model RecipeItem {
  id               String     @id @default(uuid())
  productVariantId String     @map("product_variant_id")
  ingredientId     String     @map("ingredient_id")
  quantity         Decimal    @db.Decimal(10, 4)  // cantidad por porción
  notes            String?    // "precalentar", "tamizar", etc.
  
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  ingredient       Ingredient     @relation(fields: [ingredientId], references: [id])

  @@unique([productVariantId, ingredientId])
  @@map("recipe_items")
}

// ─── ÓRDENES Y POS ────────────────────────────────────────

enum OrderStatus {
  OPEN
  IN_KITCHEN
  READY
  DELIVERED
  PAID
  CANCELLED
}

model Table {
  id       String  @id @default(uuid())
  number   Int     @unique
  zone     String?
  capacity Int     @default(4)
  isActive Boolean @default(true) @map("is_active")
  orders   Order[]
  
  @@map("tables")
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique @map("order_number") // Ej: "ORD-2024-0001"
  status      OrderStatus @default(OPEN)
  tableId     String?     @map("table_id")
  cashierId   String      @map("cashier_id")
  subtotal    Decimal     @db.Decimal(10, 2)
  tax         Decimal     @db.Decimal(10, 2)
  discount    Decimal     @default(0) @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)
  notes       String?
  
  table       Table?        @relation(fields: [tableId], references: [id])
  cashier     User          @relation(fields: [cashierId], references: [id])
  items       OrderItem[]
  payment     Payment?
  tickets     KitchenTicket[]
  
  openedAt    DateTime @default(now()) @map("opened_at")
  closedAt    DateTime? @map("closed_at")
  
  @@index([status])
  @@index([openedAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String  @map("order_id")
  variantId   String  @map("variant_id")
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  notes       String?
  
  order       Order          @relation(fields: [orderId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  modifiers   OrderItemModifier[]
  
  @@map("order_items")
}

model OrderItemModifier {
  id          String @id @default(uuid())
  orderItemId String @map("order_item_id")
  name        String
  type        String // ADD, REMOVE
  price       Decimal @db.Decimal(10, 2)
  
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  
  @@map("order_item_modifiers")
}

// ─── COCINA ───────────────────────────────────────────────

model KitchenTicket {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  station     String   // GRILL, COLD, BAR, FRYER
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, DONE
  priority    Int      @default(0)
  
  order       Order    @relation(fields: [orderId], references: [id])
  sentAt      DateTime @default(now()) @map("sent_at")
  completedAt DateTime? @map("completed_at")
  
  @@index([status, station])
  @@map("kitchen_tickets")
}

// ─── PAGOS ────────────────────────────────────────────────

model Payment {
  id        String  @id @default(uuid())
  orderId   String  @unique @map("order_id")
  method    String  // CASH, CARD, TRANSFER, MIXED
  amount    Decimal @db.Decimal(10, 2)
  change    Decimal @default(0) @db.Decimal(10, 2)
  reference String?
  
  order     Order   @relation(fields: [orderId], references: [id])
  paidAt    DateTime @default(now()) @map("paid_at")
  
  @@map("payments")
}

// ─── AUDITORÍA ────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String   // CREATE_ORDER, UPDATE_STOCK, LOGIN, etc.
  entity     String   // Order, Product, Ingredient
  entityId   String   @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ip         String?
  
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")
  
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SecurityLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  ip        String?
  metadata  Json?

  user      User?    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])

  @@map("security_logs")
}